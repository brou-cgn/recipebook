rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
             ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
             : null;
    }

    // Any authenticated user with a recognised role, OR authenticated but no user
    // document yet (bootstrap – allows the first /users/{uid} write).
    function isAnyUser() {
      return isAuthenticated() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        userRole() in ['guest', 'read', 'comment', 'edit', 'moderator', 'admin']
      );
    }

    function isEditOrAdmin() {
      return isAuthenticated() && userRole() in ['edit', 'moderator', 'admin'];
    }

    function isModeratorOrAdmin() {
      return isAuthenticated() && userRole() in ['moderator', 'admin'];
    }

    function isAdmin() {
      return isAuthenticated() && userRole() == 'admin';
    }

    // Recipes collection
    match /recipes/{recipeId} {
      // Unauthenticated share-link access is handled via Cloud Functions
      // getSharedRecipeByShareId/getSharedMenuByShareId/getSharedRecipesByIds.
      allow get: if isAnyUser() || !resource.data.isPrivate;
      allow list: if isAnyUser() || resource.data.shareId != null;
      allow create, delete: if isEditOrAdmin();
      // ratingAvg/ratingCount are written exclusively by the aggregateRecipeRating
      // Cloud Function (Admin SDK bypasses these rules) in response to changes in
      // the ratings subcollection below; no client write path for these fields.
      allow update: if isEditOrAdmin();

      // Ratings subcollection – anyone (including guests) may read and write their own rating.
      // Guests are identified by a localStorage-generated ID (prefixed 'guest_');
      // authenticated users use their Firebase UID as the document key.
      // Create/update access is granted when the raterKey matches the authenticated user's UID
      // or starts with the expected guest prefix, preventing arbitrary key injection.
      // Delete access is additionally granted to editors, moderators, and admins so they
      // can remove any rating regardless of its raterKey (admin moderation).
      match /ratings/{raterKey} {
        allow read: if true;
        // Authenticated users may create and update their own rating (keyed by UID).
        // Unauthenticated guests may only CREATE a rating under a guest_ key; they
        // cannot UPDATE to prevent iterative manipulation of existing guest ratings.
        allow create: if (request.auth != null && raterKey == request.auth.uid)
                      || raterKey.matches('guest_[a-zA-Z0-9\\-]+');
        allow update: if request.auth != null && raterKey == request.auth.uid;
        allow delete: if (request.auth != null && raterKey == request.auth.uid)
                      || raterKey.matches('guest_[a-zA-Z0-9\\-]+')
                      || isEditOrAdmin();
      }
    }

    // Menus collection
    match /menus/{menuId} {
      // Unauthenticated share-link access is handled via Cloud Functions
      // getSharedRecipeByShareId/getSharedMenuByShareId/getSharedRecipesByIds.
      allow get: if isAnyUser() || resource.data.shareId != null;
      allow list: if isAnyUser() || resource.data.shareId != null;
      allow create, update, delete: if isEditOrAdmin();
    }

    // Season matrix collection
    match /seasonMatrix/{entryId} {
      allow read: if isAnyUser();
      allow create, update, delete: if isModeratorOrAdmin();
    }

    // Getraenke-Gewichtungsmatrizen (Erwachsene + Kinder) fuer die Event-
    // Getraenkekalkulation. Dokument-ID = Kategorie-ID (siehe
    // functions/drinkRates.js DRINK_WEIGHTS / CHILDREN_DRINK_WEIGHTS).
    match /drinkWeights/{categoryId} {
      allow read: if isAnyUser();
      allow create, update, delete: if isModeratorOrAdmin();
    }

    match /drinkWeightsChildren/{categoryId} {
      allow read: if isAnyUser();
      allow create, update, delete: if isModeratorOrAdmin();
    }

    // Nutrition reference values (stored per 100g from OpenFoodFacts lookups)
    // Public read is required so unauthenticated share-link viewers can render nutrition data.
    match /nutritionReferences/{entryId} {
      allow read: if true;
      allow create, update, delete: if isModeratorOrAdmin();
    }

    // Common terms collection (e.g. grouped ingredient adjectives)
    // Public read is required so unauthenticated share-link viewers can use ingredient matching.
    match /commonTerms/{termId} {
      allow read: if true;
      allow create, update, delete: if isModeratorOrAdmin();
    }

    // FAQs collection
    match /faqs/{faqId} {
      allow read: if isAnyUser();
      allow create, update, delete: if isAdmin();
    }

    // Groups collection
    match /groups/{groupId} {
      allow read: if isAnyUser();
      allow create, update, delete: if isEditOrAdmin();
    }

    // Shopping lists collection
    match /shoppingLists/{listId} {
      allow read: if isAnyUser();
      allow create, update, delete: if isEditOrAdmin();
    }

    // Role permissions collection – stores feature permissions (fotoscan, webimport) per role.
    // All authenticated users may read; only admins may write.
    match /rolePermissions/{roleId} {
      allow read: if isAnyUser();
      allow write: if isAdmin();
    }

    // App-wide settings collection (e.g. appSettings/onboarding stores the global
    // onboarding test-mode flag). All authenticated users may read; only admins may write.
    match /appSettings/{docId} {
      allow read: if isAnyUser();
      allow write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAnyUser();
      // Authenticated users may create only their own document and may not
      // self-assign elevated privileges (isAdmin or any role above 'read').
      // The first-user / admin-bootstrap is handled atomically by the
      // createUserProfile Cloud Function (Admin SDK bypasses these rules).
      allow create: if isAuthenticated()
                    && request.auth.uid == userId
                    && !('isAdmin' in request.resource.data)
                    && request.resource.data.role == 'read';
      // Admins may update any field. Authenticated users may update only their own
      // document, but may NOT change privilege fields (role, isAdmin).
      allow update: if isAdmin()
                    || (isAuthenticated()
                        && request.auth.uid == userId
                        && !request.resource.data.diff(resource.data).affectedKeys()
                             .hasAny(['role', 'isAdmin']));
      allow delete: if isAdmin();
    }

    // Webimport-PIN (gehashter PIN + Lockout-Zähler). Ausschließlich über die
    // Cloud Functions setWebImportPin/verifyWebImportPin lesbar/schreibbar
    // (Admin SDK umgeht diese Regeln) – kein Client-Zugriff, auch nicht durch
    // den Owner, damit der Hash niemals an den Client geht.
    match /users/{userId}/security/webImportPin {
      allow read, write: if false;
    }

    // User favorites subcollection
    match /users/{userId}/favorites/{favoriteId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // User menu favorites subcollection
    match /users/{userId}/menuFavorites/{favoriteId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Event drink-calculation planning (Menüpunkt "Events").
    // Admins have full read/write access to any user's events, so they can
    // see, edit and delete events across the app.
    match /users/{userId}/events/{eventId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // User-defined custom drinks library (reusable across events).
    // Readable by any recognised user – drinks are a shared library visible to
    // everyone. Owners may create/update/delete their own entries; admins may
    // additionally edit/delete any user's entries.
    //
    // A doc carrying `extendsOwnerId` is not a standalone drink but another
    // user's own "additional units" contribution to the drink owned by
    // `extendsOwnerId` with the same `drinkId` (see mergeDrinkUnitAdditions
    // in src/utils/drinkCategories.js). It still lives under its
    // contributor's own path, so this rule already covers it without change.
    match /users/{userId}/customDrinks/{drinkId} {
      allow read: if isAnyUser();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Reusable guest profiles for drink planning
    match /users/{userId}/guestProfiles/{profileId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false;
    }

    // Guest profiles (new data model):
    // /guests/{userId}/profiles/{guestId}
    // Reads are limited to the owner, plus admins who may read any user's
    // guest profiles. All writes happen via the manageGuestProfile Cloud
    // Function (Admin SDK bypasses these rules), which additionally lets
    // admins create/update/delete any user's guest profiles.
    match /guests/{userId}/profiles/{guestId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    // Per-user calibrated consumption rates used by calculateEventDrinks.
    // Only writable via the submitConsumption Cloud Function (Admin SDK
    // bypasses these rules) so a manipulated client can't inject bogus
    // rates that would corrupt future calculations.
    match /users/{userId}/erfahrungswerte/{kategorie} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false;
    }

    // Kalibrierungs-Snapshots: Ist-Bedarfsdaten pro abgeschlossenem Event, gesammelt
    // fuer eine spaetere Kalibrierung von DRINK_WEIGHTS/BASE_RATE_PER_PERSON_PER_HOUR
    // (Phase 1, reines Sammeln -- siehe Konzept "Sammlung von Ist-Bedarfsdaten").
    // Nur ueber submitConsumption Cloud Function beschreibbar (Admin SDK bypasst
    // diese Regeln); Lesezugriff ist Admins fuer die spaetere Auswertung vorbehalten.
    match /kalibrierungsSnapshots/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Settings collection
    match /settings/{settingId} {
      // settings/app and settings/images are publicly readable so unauthenticated
      // share-link viewers can load app configuration and image metadata (favicon,
      // logo, etc.) needed to render a recipe preview.
      // All other settings documents require authentication.
      allow read: if isAnyUser() || settingId == 'app' || settingId == 'images';
      allow create: if isAdmin()
                    || (
                         isEditOrAdmin()
                         && settingId == 'standardIngredientTerms'
                         && request.resource.data.keys()
                              .hasOnly(['standardUnits', 'standardAdjectives', 'updatedAt', 'updatedBy'])
                       );
      allow delete: if isAdmin();
      // Admins may update any settings document.
      // edit/moderator users may update only the list fields in settings/app
      // (cuisineTypes, cuisineGroups, cuisineIcons, mealCategories, units,
      //  portionUnits, conversionTable, plus the legacy customUnits field) or
      //  the standard ingredient term fields in settings/standardIngredientTerms
      //  – all other fields remain admin-only.
      // Moderators may additionally update Kochatelier name/description fields.
      allow update: if isAdmin()
                 || (
                      isEditOrAdmin()
                      && settingId == 'app'
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['cuisineTypes', 'cuisineGroups', 'cuisineIcons', 'mealCategories',
                                     'units', 'portionUnits', 'conversionTable', 'customUnits'])
                    )
                 || (
                     isEditOrAdmin()
                     && settingId == 'standardIngredientTerms'
                     && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['standardUnits', 'standardAdjectives', 'updatedAt', 'updatedBy'])
                    )
                 || (
                     isModeratorOrAdmin()
                     && settingId == 'app'
                     && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['inspirationListName', 'inspirationListDescription',
                                    'inspirationTargetListName', 'inspirationTargetListDescription'])
                    );
    }

    // Button icons collection – each document stores one icon (key = iconKey, value = emoji/base64)
    match /buttonIcons/{iconId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Custom lists collection
    match /customLists/{listId} {
      // Public read is required so unauthenticated share-link viewers can load list settings.
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Category images collection
    match /categoryImages/{imageId} {
      allow read: if isAnyUser();
      allow create, update, delete: if isAdmin();
    }

    // AI Scan rate limiting collection
    match /aiScanLimits/{limitId} {
      allow read: if isEditOrAdmin();
      allow create, update, delete: if isAdmin();
    }

    // App calls audit log collection
    match /appCalls/{callId} {
      allow read: if isAnyUser();
      allow create: if isAnyUser();
      allow update, delete: if isAdmin();
    }

    // Recipe calls audit log collection
    match /recipeCalls/{callId} {
      allow read: if isAnyUser();
      allow create: if isAnyUser();
      allow update, delete: if isAdmin();
    }

    // Cook dates collection - global tracking of when users cooked recipes
    match /cookDates/{cookDateId} {
      allow read: if isAnyUser();
      allow create: if isAnyUser() && request.resource.data.userId == request.auth.uid;
      allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid)
                    || isEditOrAdmin();
    }

    // Recipe swipe flags collection - tracks user swipe actions (kandidat, geparkt, archiv) for Tagesmenü
    match /recipeSwipeFlags/{flagId} {
      // Returns true when the requesting user is the owner or a member of the given interactive list.
      // This allows list members to read each other's swipe flags for group status computation.
      function isListMemberOf(listId) {
        let listDoc = get(/databases/$(database)/documents/groups/$(listId));
        return listDoc.data.ownerId == request.auth.uid
            || ('memberIds' in listDoc.data && request.auth.uid in listDoc.data.memberIds);
      }

      allow read: if isAuthenticated()
                  && (request.auth.uid == resource.data.userID
                      || isListMemberOf(resource.data.listID));
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userID;
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.userID
        || (
          isListMemberOf(resource.data.listID)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['calculatedFlag', 'calculatedExpiresAt'])
        )
      );
      allow delete: if (isAuthenticated() && request.auth.uid == resource.data.userID)
                    || isAdmin();
    }

    // Collection-group rules: queries via collectionGroup() (subscribeToAllEvents,
    // subscribeToAllGuestProfiles, subscribeToAllCustomDrinks/getAllCustomDrinks) are only
    // authorized by a recursive-wildcard match – the path-specific rules above cover direct
    // get()/collection reads but do NOT extend to collection-group list requests. Without
    // these, an admin's "Alle Anwender" view (and everyone's shared custom-drinks library)
    // briefly shows the locally cached snapshot before the live query is permission-denied,
    // clearing the list again.
    match /{path=**}/events/{eventId} {
      allow read: if isAdmin();
    }

    match /{path=**}/customDrinks/{drinkId} {
      allow read: if isAnyUser();
    }

    match /{path=**}/profiles/{guestId} {
      allow read: if isAdmin();
    }

    // Failed web imports collection - logs URL + error message whenever a user dismisses
    // a failed web import, so app development can investigate what went wrong on that
    // site. Write-only debugging data for admins; regular users cannot read others' logs.
    // Also holds server-written step-by-step protocol entries for Instagram Reel / video
    // imports (see writeImportProtocolEntry in functions/index.js) - those writes use the
    // Admin SDK and bypass these rules entirely; failed entries are kept indefinitely,
    // successful ones are deleted after 7 days by nightlyImportProtocolCleanup.
    match /failedWebImports/{entryId} {
      allow read: if isAdmin();
      allow create: if isAnyUser();
      allow update, delete: if isAdmin();
    }

    // Cuisine proposals collection - tracks user-proposed cuisine types for admin review
    match /cuisineProposals/{proposalId} {
      // Any authenticated user can read proposals
      allow read: if isAnyUser();

      // Users with edit permission can create proposals
      allow create: if isEditOrAdmin()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.released == false;

      // Users can edit their own proposals; admins can edit any
      allow update: if (isEditOrAdmin() && resource.data.createdBy == request.auth.uid)
                    || isAdmin();

      // Only admins can delete proposals
      allow delete: if isAdmin();
    }

  }
}
