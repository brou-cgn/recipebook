{
  "name": "functions",
  "description": "Firebase Cloud Functions for RecipeBook",
  "version": "1.0.0",
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@sparticuz/chromium": "^153.0.0",
    "cheerio": "^1.0.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "nodemailer": "^10.2.1",
    "puppeteer-core": "^25.16.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  },
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "lint:ci": "eslint .",
    "test": "node --test",
    "test:ci": "node test-ci.js",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  }
}
