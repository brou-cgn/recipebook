rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check user role from Firestore
    function getUserRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    // Check if user has edit permissions or higher
    function hasEditPermission() {
      return isAuthenticated() &&
             getUserRole() in ['edit', 'moderator', 'admin'];
    }

    // Check if user is admin
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    // A registered member (not an anonymous guest) with a profile role, as
    // isMember() in firestore.rules
    function isMember() {
      return isAuthenticated() &&
             request.auth.token.firebase.sign_in_provider != 'anonymous' &&
             getUserRole() in ['read', 'comment', 'edit', 'moderator', 'admin'];
    }

    // Recipe images - require edit permission
    match /recipes/{recipeImage} {
      allow read: if true;  // Public read access
      allow write: if hasEditPermission();
      allow delete: if hasEditPermission();
    }

    // Settings images (favicon, app logo) - require admin permission
    match /settings/{settingImage} {
      allow read: if true;  // Public read access
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }

    // Thumbnails for shared recipes and recipe list overviews - public read, edit+ write
    match /thumbnails/{thumbnail} {
      allow read: if true;  // Public read access
      allow write: if hasEditPermission();
      allow delete: if hasEditPermission();
    }

    // Drink photos (Getränke im Eventmodul) - every member maintains their own
    // drinks, so no edit role is required. Files live below the uploader's uid:
    // only that member (never an anonymous guest) may upload there, only the
    // owner or an admin may delete (Tech-Check S25). Images up to 5 MB.
    match /drinks/{userId}/{drinkImage} {
      allow read: if true;  // Public read access (also shown in menus)
      allow create: if isMember() && request.auth.uid == userId &&
                       request.resource.contentType.matches('image/.*') &&
                       request.resource.size < 5 * 1024 * 1024;
      allow delete: if (isMember() && request.auth.uid == userId) || isAdmin();
    }

    // Drink photos uploaded before S25 directly below drinks/: the uploader is
    // unknown, so they stay readable and only admins may delete them.
    match /drinks/{drinkImage} {
      allow read: if true;  // Public read access
      allow delete: if isAdmin();
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
